# ── Gemini (untuk koreksi esai AI & Tutor) ──────────────────────────────
# Ambil API key gratis di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Opsional, default: gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# ── Neon Postgres (untuk menyimpan skor & riwayat esai) ─────────────────
# Buat database gratis di https://neon.tech lalu salin connection string-nya
# Contoh: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Autentikasi / Login ─────────────────────────────────────────────────
# WAJIB untuk fitur login. Isi AUTH_SECRET dengan string acak panjang.
AUTH_SECRET=ganti-dengan-string-acak-panjang
# Akun admin awal untuk login pertama & membuat akun user lain.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ubah-password-ini

# Catatan: GEMINI & DATABASE di atas OPSIONAL (login butuh DATABASE_URL untuk akun user).
# - Tanpa GEMINI_API_KEY: fitur AI dinonaktifkan, sisanya tetap jalan.
# - Tanpa DATABASE_URL: progres disimpan di localStorage browser.
